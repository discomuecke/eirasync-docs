{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "EiraSync",
  "colors": {
    "primary": "#C67D10",
    "light": "#C67D10",
    "dark": "#F0A830"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/quick-start",
          "getting-started/add-device"
        ]
      },
      {
        "group": "Migration Guides",
        "pages": [
          "migration-guides/from-icloud",
          "migration-guides/from-obsidian-sync",
          "migration-guides/from-self-hosted"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting/connection-failed",
          "troubleshooting/sync-conflicts",
          "troubleshooting/reset-database"
        ]
      },
      {
        "group": "Security & Architecture",
        "pages": [
          "security-architecture/zero-knowledge",
          "security-architecture/infrastructure"
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "resources/faq",
          "resources/changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://eirasync.app"
  },
  "fonts": {
    "family": "Geist"
  },
  "navbar": {
    "links": []
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "strict": false
  },
  "seo": {
    "indexing": "navigable"
  }
